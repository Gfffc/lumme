# ============== SERVIDOR ==============
PORT=8080
NODE_ENV=development

# ============== BANCO DE DADOS ==============
# SQLite para desenvolvimento (zero setup)
DATABASE_URL="file:./dev.db"
# Para produção use Postgres:
# DATABASE_URL="postgresql://user:pass@localhost:5432/lumme"

# ============== SEGURANÇA ==============
# JWT: gere com `openssl rand -base64 32`
JWT_SECRET=troque-isto-em-producao-com-32-caracteres-aleatorios
JWT_EXPIRES_IN=7d

# Criptografia AES-256-GCM dos tokens SmartThings
# Gere com: openssl rand -hex 32  (precisa ter exatamente 64 hex = 32 bytes)
TOKEN_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ============== SMARTTHINGS ==============
# Registre um app em https://developer.smartthings.com/workspace/
ST_CLIENT_ID=seu-client-id-aqui
ST_CLIENT_SECRET=seu-client-secret-aqui
ST_REDIRECT_URI=https://lumme-2kng.onrender.com/api/v1/auth/smartthings/callback
ST_SCOPES=r:devices:* x:devices:* r:locations:*

# Deep link de retorno para o app Android
APP_REDIRECT_URI=lumme://oauth-callback

# ============== MOCK MODE ==============
# Quando true, simula toda a integração SmartThings — ideal para dev/testes
MOCK_SMARTTHINGS=true
